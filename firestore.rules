rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================================================
    // 1. PERFIL DE USUARIOS Y CLASIFICACIÓN GLOBAL (LEADERBOARD)
    // ========================================================================
    match /users/{userId} {
      allow read: if true;
      
      // Creación permitida para el propio usuario autenticado con bono inicial máximo de 200 monedas
      allow create: if request.auth != null && request.auth.uid == userId && 
                    (!('coins' in request.resource.data) || request.resource.data.coins <= 200);
      
      // Actualización: Blindaje Zero-Trust estricto.
      // El cliente NUNCA puede mutar 'coins', 'escrowLockedCoins', 'role', 'isBanned' ni 'isFrozen'.
      // Las mutaciones de balance ocurren exclusivamente a través del backend autoritativo (Admin SDK).
      allow update: if request.auth != null && request.auth.uid == userId &&
                    !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['coins', 'escrowLockedCoins', 'role', 'isBanned', 'isFrozen']);
                      
      allow delete: if false;
      
      // Buzón de notificaciones (inbox): Solo el servidor escribe
      match /inbox/{mailId} {
        allow read: if true;
        allow write: if false;
      }
      
      // Historial de partidas del jugador
      match /match_history/{matchId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // ========================================================================
    // 2. SISTEMA DE AMISTADES, SOLICITUDES Y DUELOS 1 VS 1
    // ========================================================================
    match /friendships/{friendshipId} {
      allow read, write: if true;
    }
    
    match /friend_requests/{requestId} {
      allow read, write: if true;
    }
    
    match /duel_challenges/{challengeId} {
      allow read, write: if true;
    }
    
    // ========================================================================
    // 3. BILLETERAS Y REGISTRO DE TRANSACCIONES (BLINDADAS)
    // ========================================================================
    match /wallets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Inmutable desde clientes: exclusivo del Admin SDK
    }
    
    match /transactions/{txId} {
      allow read: if request.auth != null;
      allow write: if false; // Inmutable desde clientes: exclusivo del Admin SDK
    }

    // ========================================================================
    // 4. SISTEMA DE CAJEROS P2P Y CHAT DE SOPORTE
    // ========================================================================
    match /cashier_orders/{orderId} {
      allow read: if true;
      
      // Creación permitida para órdenes nuevas en estado 'pending'
      allow create: if request.resource.data.status == 'pending';
      
      // Actualización de cliente restringida a comprobantes, chat y lecturas
      // (Liquidaciones y cambios a 'completed' son exclusivos de transacciones Admin SDK)
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly([
                        'messages', 
                        'supportMessages', 
                        'lastMessage', 
                        'lastMessageTime', 
                        'hasUnreadCashierMessage', 
                        'playerReadAt',
                        'receiptUrl',
                        'receiptReferenceNumber',
                        'receiptUploadedAt'
                      ]);
                      
      allow delete: if false;
      
      // Mensajes y chat de la orden
      match /messages/{messageId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
    
    // Perfiles operativos de cajeros: Modificaciones exclusivas del Super Admin vía backend
    match /cashier_profiles/{cashierId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Estadísticas contables diarias: Gestionadas exclusivamente por transacciones del servidor
    match /daily_stats/{dateStr} {
      allow read: if true;
      allow write: if false;
    }
    
    // Registro inmutable de auditoría: Lectura para auditoría, escritura exclusiva del servidor
    match /audit_logs/{logId} {
      allow read: if true;
      allow write: if false;
    }

    // ========================================================================
    // 5. ECOSISTEMA CONTABLE, TESORERÍA INSTITUCIONAL Y CONFIGURACIÓN
    // ========================================================================
    match /system_treasury/{treasuryId} {
      // Lectura permitida para métricas en vivo (live_telemetry y global_ledger en Super Admin)
      allow read: if true;
      allow write: if false; // Exclusivo de transacciones atómicas del backend (Admin SDK)
    }

    match /system_config/{configId} {
      allow read: if true;
      allow write: if false; // Solo Super Admin vía servidor
    }

    match /cashier_shifts_ledger/{ledgerId} {
      allow read: if true;
      allow write: if false; // Exclusivo del servidor
    }

    match /dispute_cases/{disputeId} {
      allow read: if true;
      allow write: if false; // Arbitraje exclusivo vía servidor
    }

    // ========================================================================
    // 6. COMUNICACIONES INTERNAS DE STAFF
    // ========================================================================
    match /staff_broadcast_messages/{msgId} {
      allow read: if true;
      allow write: if false; // Emisión exclusiva del servidor autoritativo (Admin SDK / API protegida)
    }

    match /staff_private_chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // ========================================================================
    // 7. TORNEOS Y EVENTOS COMPETITIVOS EN VIVO
    // ========================================================================
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
