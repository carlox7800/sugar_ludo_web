rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isServerBackend() {
      return request.auth != null && (
        request.auth.token.role in ['super_admin', 'server_daemon'] ||
        request.auth.uid == 'sugar_system_treasury_daemon' ||
        request.auth.token.email == 'server-treasury@sugarludo.com'
      );
    }

    // 1. PERFIL DE USUARIOS Y CLASIFICACIÓN GLOBAL (LEADERBOARD)
    match /users/{userId} {
      allow read: if true;
      // Creación permitida únicamente al registrarse con saldo inicial máximo de 200 monedas
      allow create: if request.auth != null && request.auth.uid == userId && 
                    (!('coins' in request.resource.data) || request.resource.data.coins <= 200) &&
                    (!('escrowLockedCoins' in request.resource.data) || request.resource.data.escrowLockedCoins == 0) &&
                    (!('role' in request.resource.data) || request.resource.data.role == 'player');
      // Actualización: BLINDAJE ZERO-TRUST + LEY DE CONSERVACIÓN CONTABLE MATEMÁTICA
      // 1. Servidor privilegiado (Admin SDK o daemon de tesorería)
      allow update: if isServerBackend() || (
        // 2. Modificación de perfil no financiera por parte del propio jugador
        request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['coins', 'escrowLockedCoins', 'role', 'isBanned', 'isFrozen'])
      ) || (
        // 3. RETENCIÓN LEGÍTIMA POR RETIRO (ESCROW LOCK): Invariante matemática estricta
        // El jugador autenticado mueve coins -> escrowLockedCoins:
        // - Invariante 1: Cero generación de dinero (coins + escrowLockedCoins es idéntico a la suma previa)
        // - Invariante 2: coins disminuye (se deduce el monto solicitado)
        // - Invariante 3: escrowLockedCoins aumenta (se congela en custodia)
        // - Invariante 4: coins final >= 0 (no sobregiro)
        // - Prohibido alterar rol, baneo o congelamiento
        request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBanned', 'isFrozen']) &&
        request.resource.data.coins < resource.data.coins &&
        request.resource.data.coins >= 0 &&
        request.resource.data.escrowLockedCoins > resource.data.escrowLockedCoins &&
        (request.resource.data.coins + request.resource.data.escrowLockedCoins) == (resource.data.coins + resource.data.escrowLockedCoins)
      ) || (
        // 4. LIBERACIÓN DE ESCROW POR LIQUIDACIÓN DE RETIRO (PAGO COMPLETADO AL JUGADOR):
        // Permite extinguir escrowLockedCoins cuando el cajero liquida el retiro
        // - coins permanece idéntico (no se puede generar ni alterar saldo disponible)
        // - escrowLockedCoins disminuye (>= 0)
        // - Prohibido alterar rol, baneo o congelamiento
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'role', 'isBanned', 'isFrozen']) &&
        request.resource.data.coins == resource.data.coins &&
        request.resource.data.escrowLockedCoins < resource.data.escrowLockedCoins &&
        request.resource.data.escrowLockedCoins >= 0
      ) || (
        // 5. REEMBOLSO POR CANCELACIÓN DE RETIRO (DEVOLUCIÓN DE ESCROW A SALDO DISPONIBLE):
        // Si el retiro es cancelado o rechazado, escrow vuelve a coins con estricta conservación:
        // - Suma total (coins + escrowLockedCoins) permanece idéntica
        // - escrowLockedCoins disminuye (>= 0)
        // - coins aumenta exactamente lo liberado
        // - Prohibido alterar rol, baneo o congelamiento
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBanned', 'isFrozen']) &&
        request.resource.data.escrowLockedCoins < resource.data.escrowLockedCoins &&
        request.resource.data.escrowLockedCoins >= 0 &&
        request.resource.data.coins > resource.data.coins &&
        (request.resource.data.coins + request.resource.data.escrowLockedCoins) == (resource.data.coins + resource.data.escrowLockedCoins)
      );
      allow delete: if false;
      
      match /inbox/{mailId} {
        allow read: if true;
        allow write: if false;
      }
      
      match /match_history/{matchId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 2. SISTEMA DE AMISTADES DEDICADO
    match /friendships/{friendshipId} {
      allow read, write: if true;
    }
    
    // 3. SOLICITUDES DE AMISTAD EN TIEMPO REAL
    match /friend_requests/{requestId} {
      allow read, write: if true;
    }
    
    // 4. RETOS A DUELOS 1 VS 1 EN TIEMPO REAL
    match /duel_challenges/{challengeId} {
      allow read, write: if true;
    }
    
    // 5. BILLETERAS Y TRANSACCIONES (BLINDADAS: Solo backend Admin SDK)
    match /wallets/{userId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /transactions/{txId} {
      allow read: if true;
      allow write: if false;
    }

    // 6. SISTEMA DE CAJEROS P2P, CHAT Y AUDITORÍA
    match /cashier_orders/{orderId} {
      allow read: if true;
      // Creación de órdenes en pending por parte de jugadores
      allow create: if request.resource.data.status == 'pending';
      // Actualizaciones autorizadas: transiciones de ciclo de vida (pending, paid, verified, completed, cancelled, disputed),
      // resoluciones de arbitraje o actualizaciones de mensajes y confirmaciones de lectura
      allow update: if request.resource.data.status in ['pending', 'paid', 'verified', 'completed', 'cancelled', 'disputed', 'resolved_player', 'resolved_cashier'] ||
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['messages', 'supportMessages', 'lastMessage', 'lastMessageTime', 'hasUnreadCashierMessage', 'hasUnreadPlayerMessage', 'playerReadAt', 'payoutTxId', 'receiptReferenceNumber', 'verifiedAt', 'completedAt', 'disputeReason', 'resolutionNotes', 'resolvedBy', 'resolvedAt']);
      allow delete: if false;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    match /cashier_profiles/{cashierId} {
      allow read, write: if true;
    }
    
    match /daily_stats/{dateStr} {
      allow read, write: if true;
    }
    
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // 7. ECOSISTEMA CONTABLE, TESORERÍA INSTITUCIONAL Y CONFIGURACIÓN CENTRALIZADA
    match /system_treasury/{treasuryId} {
      allow read, write: if true;
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /cashier_shifts_ledger/{ledgerId} {
      allow read, write: if true;
    }

    match /dispute_cases/{disputeId} {
      allow read, write: if true;
    }

    // 8. COMUNICACIONES INTERNAS DE STAFF Y CHAT DUAL CON CAJEROS
    match /staff_broadcast_messages/{msgId} {
      allow read, write: if true;
    }

    match /staff_private_chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 9. TORNEOS Y EVENTOS COMPETITIVOS EN VIVO
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
