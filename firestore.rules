rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. PERFIL DE USUARIOS Y CLASIFICACIÓN GLOBAL (LEADERBOARD)
    match /users/{userId} {
      allow read: if true;
      // Creación permitida para el propio usuario con bono inicial máximo de 200 monedas
      allow create: if request.auth != null && request.auth.uid == userId && 
                    (!('coins' in request.resource.data) || request.resource.data.coins <= 200);
      // Actualización: Permitida para el usuario propio (sin tocar escrowLockedCoins ni roles de baneo) o actualizaciones de acreditación financiera
      allow update: if (request.auth != null && request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['escrowLockedCoins', 'role', 'isBanned', 'isFrozen'])) ||
                       (request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['coins', 'walletHistory', 'lastActiveAt', 'inbox']));
      allow delete: if false;
      
      match /inbox/{mailId} {
        allow read: if true;
        allow write: if false;
      }
      
      match /match_history/{matchId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 2. SISTEMA DE AMISTADES DEDICADO
    match /friendships/{friendshipId} {
      allow read, write: if true;
    }
    
    // 3. SOLICITUDES DE AMISTAD EN TIEMPO REAL
    match /friend_requests/{requestId} {
      allow read, write: if true;
    }
    
    // 4. RETOS A DUELOS 1 VS 1 EN TIEMPO REAL
    match /duel_challenges/{challengeId} {
      allow read, write: if true;
    }
    
    // 5. BILLETERAS Y TRANSACCIONES (BLINDADAS: Solo backend Admin SDK)
    match /wallets/{userId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /transactions/{txId} {
      allow read: if true;
      allow write: if false;
    }

    // 6. SISTEMA DE CAJEROS P2P, CHAT Y AUDITORÍA
    match /cashier_orders/{orderId} {
      allow read: if true;
      // Creación de órdenes en pending por parte de jugadores
      allow create: if request.resource.data.status == 'pending';
      // Cancelación de órdenes pendientes, liquidaciones autorizadas o actualizaciones de chat y lectura
      allow update: if (resource.data.status == 'pending' && (request.resource.data.status == 'cancelled' || request.resource.data.status == 'completed')) ||
                    request.resource.data.status == 'completed' ||
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['messages', 'supportMessages', 'lastMessage', 'lastMessageTime', 'hasUnreadCashierMessage', 'hasUnreadPlayerMessage', 'playerReadAt']);
      allow delete: if false;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    match /cashier_profiles/{cashierId} {
      allow read: if true;
      // Saldo flotante blindado contra manipulación de cliente; solo backend
      allow write: if false;
    }
    
    match /daily_stats/{dateStr} {
      allow read: if true;
      allow write: if false;
    }
    
    match /audit_logs/{logId} {
      allow read: if true;
      allow write: if false;
    }

    // 7. ECOSISTEMA CONTABLE, TESORERÍA INSTITUCIONAL Y CONFIGURACIÓN CENTRALIZADA
    match /system_treasury/{treasuryId} {
      allow read: if true;
      // Solo permitir escritura en live_telemetry para presencia en tiempo real; global_ledger blindado
      allow write: if treasuryId == 'live_telemetry';
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /cashier_shifts_ledger/{ledgerId} {
      allow read: if true;
      // Arqueos y movimientos de caja blindados contra cliente; solo backend
      allow write: if false;
    }

    match /dispute_cases/{disputeId} {
      allow read, write: if true;
    }

    // 8. COMUNICACIONES INTERNAS DE STAFF Y CHAT DUAL CON CAJEROS
    match /staff_broadcast_messages/{msgId} {
      allow read, write: if true;
    }

    match /staff_private_chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 9. TORNEOS Y EVENTOS COMPETITIVOS EN VIVO
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
