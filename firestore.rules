rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. PERFIL DE USUARIOS Y CLASIFICACION GLOBAL
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId && 
                    (!('coins' in request.resource.data) || request.resource.data.coins <= 200);
      allow update: if (request.auth != null && request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['role', 'isBanned', 'isFrozen'])) ||
                       (request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny([
                            'coins', 'escrowLockedCoins', 'walletHistory', 'lastActiveAt', 
                            'inbox', 'lastSettledDepositId', 'lastSettledWithdrawalId', 
                            'payoutTxId', 'unreadMailCount', 'unreadMessages', 'playerReadAt'
                          ]));
      allow delete: if false;
      
      match /inbox/{mailId} {
        allow read, write: if true;
      }
      match /match_history/{matchId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 2. AMISTADES Y DUELOS
    match /friendships/{friendshipId} {
      allow read, write: if true;
    }
    match /friend_requests/{requestId} {
      allow read, write: if true;
    }
    match /duel_challenges/{challengeId} {
      allow read, write: if true;
    }
    
    // 3. BILLETERAS Y TRANSACCIONES
    match /wallets/{userId} {
      allow read, write: if true;
    }
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // 4. CAJEROS P2P Y CHAT
    match /cashier_orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update: if (resource.data.status == 'pending' && (request.resource.data.status == 'cancelled' || request.resource.data.status == 'completed')) ||
                    request.resource.data.status == 'completed' ||
                    (request.auth != null && resource.data.playerUid == request.auth.uid) ||
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny([
                        'status', 'completedAt', 'cancelledAt', 'payoutTxId',
                        'messages', 'supportMessages', 'lastMessage', 'lastMessageTime', 
                        'hasUnreadCashierMessage', 'playerReadAt', 'receiptUrl',
                        'receiptReferenceNumber', 'receiptUploadedAt', 'cashierUid', 'cashierName'
                      ]);
      allow delete: if false;
      
      match /messages/{messageId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
    match /cashier_profiles/{cashierId} {
      allow read, write: if true;
    }
    match /daily_stats/{dateStr} {
      allow read: if true;
    }
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // 5. TESORERIA Y CONFIGURACION
    match /system_treasury/{treasuryId} {
      allow read, write: if true;
    }
    match /system_config/{configId} {
      allow read, write: if true;
    }
    match /cashier_shifts_ledger/{ledgerId} {
      allow read, write: if true;
    }
    match /dispute_cases/{disputeId} {
      allow read, write: if true;
    }

    // 6. DIFUSIONES Y COMUNICACIONES DE STAFF
    match /staff_broadcast_messages/{msgId} {
      allow read: if true;
      allow write: if false;
    }
    match /staff_private_chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 7. TORNEOS
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
