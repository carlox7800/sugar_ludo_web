rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. PERFIL DE USUARIOS Y CLASIFICACIÓN GLOBAL (LEADERBOARD)
    match /users/{userId} {
      allow read, write: if true;
      
      match /inbox/{mailId} {
        allow read, write: if true;
      }
      
      match /match_history/{matchId} {
        allow read, write: if true;
      }
    }
    
    // 2. SISTEMA DE AMISTADES DEDICADO
    match /friendships/{friendshipId} {
      allow read, write: if true;
    }
    
    // 3. SOLICITUDES DE AMISTAD EN TIEMPO REAL
    match /friend_requests/{requestId} {
      allow read, write: if true;
    }
    
    // 4. RETOS A DUELOS 1 VS 1 EN TIEMPO REAL
    match /duel_challenges/{challengeId} {
      allow read, write: if true;
    }
    
    // 5. BILLETERAS Y TRANSACCIONES
    match /wallets/{userId} {
      allow read, write: if true;
    }
    
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // 6. SISTEMA DE CAJEROS P2P, CHAT Y AUDITORÍA
    match /cashier_orders/{orderId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    match /cashier_profiles/{cashierId} {
      allow read, write: if true;
    }
    
    match /daily_stats/{dateStr} {
      allow read, write: if true;
    }
    
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // 7. ECOSISTEMA CONTABLE, TESORERÍA INSTITUCIONAL Y CONFIGURACIÓN CENTRALIZADA
    match /system_treasury/{treasuryId} {
      allow read, write: if true;
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /cashier_shifts_ledger/{ledgerId} {
      allow read, write: if true;
    }

    match /dispute_cases/{disputeId} {
      allow read, write: if true;
    }

    // 8. COMUNICACIONES INTERNAS DE STAFF Y CHAT DUAL CON CAJEROS
    match /staff_broadcast_messages/{msgId} {
      allow read, write: if true;
    }

    match /staff_private_chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 9. TORNEOS Y EVENTOS COMPETITIVOS EN VIVO
    match /tournaments/{tournamentId} {
      allow read, write: if true;
    }
  }
}
