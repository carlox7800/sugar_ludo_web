rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================================================
    // 1. PERFIL DE USUARIOS Y CLASIFICACIÓN GLOBAL (LEADERBOARD)
    // ========================================================================
    match /users/{userId} {
      allow read: if true;
      
      // Creación permitida para el propio usuario autenticado con bono inicial máximo de 200 monedas
      allow create: if request.auth != null && request.auth.uid == userId && 
                    (!('coins' in request.resource.data) || request.resource.data.coins <= 200);
      
      // Actualización: Permite al usuario su perfil básico, y autoriza mutaciones financieras
      // de depósito, retiro (walletHistory), balances y marcas de lectura
      allow update: if (request.auth != null && request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['role', 'isBanned', 'isFrozen'])) ||
                       (request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny([
                            'coins', 
                            'escrowLockedCoins', 
                            'walletHistory', 
                            'lastActiveAt', 
                            'inbox', 
                            'lastSettledDepositId', 
                            'lastSettledWithdrawalId', 
                            'payoutTxId',
                            'unreadMailCount', 
                            'unreadMessages', 
                            'playerReadAt'
                          ]));
                          
      allow delete: if false;
      
      // Buzón de notificaciones (inbox): Lectura y marcado de lectura habilitado
      match /inbox/{mailId} {
        allow read, write: if true;
      }
      
      // Historial de partidas del jugador
      match /match_history/{matchId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // ========================================================================
    // 2. SISTEMA DE AMISTADES, SOLICITUDES Y DUELOS 1 VS 1
    // ========================================================================
    match /friendships/{friendshipId} {
      allow read, write: if true;
    }
    
    match /friend_requests/{requestId} {
      allow read, write: if true;
    }
    
    match /duel_challenges/{challengeId} {
      allow read, write: if true;
    }
    
    // ========================================================================
    // 3. BILLETERAS Y REGISTRO DE TRANSACCIONES
    // ========================================================================
    match /wallets/{userId} {
      allow read, write: if true;
    }
    
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // ========================================================================
    // 4. SISTEMA DE CAJEROS P2P Y CHAT DE SOPORTE
    // ========================================================================
    match /cashier_orders/{orderId} {
      allow read: if true;
      
      // Creación permitida para órdenes nuevas en estado 'pending'
      allow create: if request.resource.data.status == 'pending';
      
      // Actualización autorizada para liquidaciones, cancelaciones, mensajes y comprobantes
      allow update: if (resource.data.status == 'pending' && (request.resource.data.status == 'cancelled' || request.resource.data.status == 'completed')) ||
                    request.resource.data.status == 'completed' ||
                    (request.auth != null && resource.data.playerUid == request.auth.uid) ||
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny([
                        'status',
                        'completedAt',
                        'cancelledAt',
                        'payoutTxId',
                        'messages', 
                        'supportMessages', 
                        'lastMessage', 
                        'lastMessageTime', 
                        'hasUnreadCashierMessage', 
                        'playerReadAt',
                        'receiptUrl',
                        'receiptReferenceNumber',
                        'receiptUploadedAt',
                        'cashierUid',
                        'cashierName'
                      ]);
                      
      allow delete: if false;
      
      // Mensajes y chat de la orden
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    // Perfiles operativos de cajeros: Habilitado para sincronización de balance flotante
    match /cashier_profiles/{cashierId} {
      allow read, write: if true;
    }
    
    // Estadísticas contables diarias
    match /daily_stats/{dateStr} {
      allow read: if true;
    }
    
    // Registro de auditoría
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // ========================================================================
    // 5. ECOSISTEMA CONTABLE, TESORERÍA INSTITUCIONAL Y CONFIGURACIÓN
    // ========================================================================
    match /system_treasury/{treasuryId} {
      allow read, write: if true;
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /cashier_shifts_ledger/{ledgerId} {
      allow read, write: if true;
    }

    match /dispute_cases/{disputeId} {
      allow read, write: if true;
    }

    // ========================================================================
    // 6. COMUNICACIONES INTERNAS DE STAFF
    // ========================================================================
    match /staff_broadcast_messages/{msgId} {
      allow read, write: if true;
    }

    match /staff_private_chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // ========================================================================
    // 7. TORNEOS Y EVENTOS COMPETITIVOS EN VIVO
    // ========================================================================
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if false;
    }
  }
}